{
  "expo": {
    "name": "DriveHub",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.digitalcockpit.gdvqgn",
      "requireFullScreen": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Enable voice commands for hands-free driving",
        "NSLocationWhenInUseUsageDescription": "Show your position on the map",
        "NSContactsUsageDescription": "Access contacts for hands-free calling"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#090A0C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.digitalcockpit.gdvqgn",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-screen-orientation",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DriveHub to show your position on the map."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#090A0C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
